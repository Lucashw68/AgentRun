{
  "allowedRoots": ["~/.codex/worktrees"],
  "profiles": {
    "npm-dev": { "command": ["npm", "run", "dev"] },
    "npm-start": { "command": ["npm", "run", "start"] },
    "npm-preview": { "command": ["npm", "run", "preview"] },
    "pnpm-dev": { "command": ["pnpm", "dev"] },
    "pnpm-start": { "command": ["pnpm", "run", "start"] },
    "pnpm-preview": { "command": ["pnpm", "run", "preview"] },
    "yarn-dev": { "command": ["yarn", "run", "dev"] },
    "yarn-start": { "command": ["yarn", "run", "start"] },
    "yarn-preview": { "command": ["yarn", "run", "preview"] },
    "bun-dev": { "command": ["bun", "run", "dev"] },
    "bun-start": { "command": ["bun", "run", "start"] },
    "bun-preview": { "command": ["bun", "run", "preview"] },
    "vite": { "command": ["npx", "--no-install", "vite", "--host", "127.0.0.1"] },
    "vite-preview": { "command": ["npx", "--no-install", "vite", "preview", "--host", "127.0.0.1"] },
    "next-dev": { "command": ["npx", "--no-install", "next", "dev", "--hostname", "127.0.0.1"] },
    "next-start": { "command": ["npx", "--no-install", "next", "start", "--hostname", "127.0.0.1"] },
    "nuxt-dev": { "command": ["npx", "--no-install", "nuxt", "dev", "--host", "127.0.0.1"] },
    "astro-dev": { "command": ["npx", "--no-install", "astro", "dev", "--host", "127.0.0.1"] },
    "astro-preview": { "command": ["npx", "--no-install", "astro", "preview", "--host", "127.0.0.1"] },
    "angular-dev": { "command": ["npx", "--no-install", "ng", "serve", "--host", "127.0.0.1"] },
    "nest-dev": { "command": ["npx", "--no-install", "nest", "start", "--watch"] },
    "python-http": { "command": ["python3", "-m", "http.server", "8000", "--bind", "127.0.0.1"] },
    "django-dev": { "command": ["python3", "manage.py", "runserver", "127.0.0.1:8000"] },
    "flask-dev": { "command": ["python3", "-m", "flask", "--app", "app", "run", "--reload", "--host", "127.0.0.1"] },
    "uvicorn-dev": { "command": ["python3", "-m", "uvicorn", "main:app", "--reload", "--host", "127.0.0.1"] },
    "fastapi-dev": { "command": ["fastapi", "dev", "main.py", "--host", "127.0.0.1"] },
    "streamlit-dev": { "command": ["python3", "-m", "streamlit", "run", "app.py", "--server.address", "127.0.0.1", "--server.headless", "true", "--browser.gatherUsageStats", "false"] },
    "celery-worker": { "command": ["python3", "-m", "celery", "-A", "app", "worker", "--loglevel", "info"] },
    "cargo-run": { "command": ["cargo", "run", "--locked"] },
    "go-run": { "command": ["go", "run", "."] },
    "dotnet-watch": { "command": ["dotnet", "watch", "--non-interactive", "run"] },
    "rails-dev": { "command": ["bundle", "exec", "rails", "server", "--binding", "127.0.0.1"] },
    "laravel-dev": { "command": ["php", "artisan", "serve", "--host=127.0.0.1"] },
    "php-server": { "command": ["php", "-S", "127.0.0.1:8000", "-t", "public"] },
    "spring-boot": { "command": ["mvn", "spring-boot:run"] },
    "quarkus-dev": { "command": ["mvn", "quarkus:dev"] },
    "make-dev": { "make": { "file": "Makefile", "target": "dev" } },
    "compose-dev": { "compose": { "files": ["compose.yml"] } }
  }
}
